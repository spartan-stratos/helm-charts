          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"$service\",span_kind=\"SPAN_KIND_SERVER\",http_route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true
